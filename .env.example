PORT=3000
HOST=0.0.0.0
# The exact public HTTPS origin; no trailing slash. Required in production.
# Canonical HTTPS origin for Node production; on Cloudflare this is set in wrangler.jsonc.
# For Cloudflare, set verified FORMSPREE_FORM_ID as a Worker secret outside Git.
SITE_URL=
# Server-side only. Verified Formspree form ID (letters/numbers).
FORMSPREE_FORM_ID=
# Production startup requires all launch placeholders to have been replaced.
NODE_ENV=development
