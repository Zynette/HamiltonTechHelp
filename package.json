{
  "name": "online-technical-help",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "check": "prettier --check . && node --check src/server.js && node --check src/validation.js && node --check public/app.js && node --check scripts/check-release.js",
    "test": "node --test test/*.test.js",
    "check:release": "node --env-file-if-exists=.env scripts/check-release.js",
    "test:browser": "playwright test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.9"
  }
}
