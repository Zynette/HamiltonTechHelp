{
  "name": "online-technical-help",
  "main": "src/cloudflare-worker.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/*.html",
      "/remote-tech-support",
      "/website-design",
      "/website-maintenance",
      "/business-solutions",
      "/portfolio",
      "/about",
      "/contact",
      "/fil",
      "/fil/*",
      "/clinic",
      "/resources",
      "/journal",
      "/journal/*",
      "/api/*",
      "/healthz",
      "/robots.txt",
      "/sitemap.xml",
    ],
  },
  "vars": {
    "SITE_URL": "https://onlinetechnicalhelp.com",
  },
  "routes": [
    {
      "pattern": "onlinetechnicalhelp.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.onlinetechnicalhelp.com",
      "custom_domain": true,
    },
  ],
}
